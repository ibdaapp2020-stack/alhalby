rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasStaffClaim() {
      return request.auth.token.role in ['Admin', 'Manager', 'Employee']
        && request.auth.token.active == true;
    }

    // Storage cannot read the staff profile through Firestore on this project,
    // so staff authority comes from the Auth token. The owner mailbox is
    // accepted as well, including sessions issued before the claim existed.
    function isStaff() {
      return isSignedIn() && (
        hasStaffClaim()
        || request.auth.token.email == 'admin@alhalabi.com'
      );
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /settings/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /modifiers/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /test/{allPaths=**} {
      allow read, write: if isStaff();
    }
  }
}
