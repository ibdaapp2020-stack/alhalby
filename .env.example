# ──────────────────────────────────────────────────────────────────────────
# STORE-STARTER — environment template
# Copy this file to `.env.local` and fill in the values for your deployment.
# Never commit `.env.local` — it is gitignored by default.
# ──────────────────────────────────────────────────────────────────────────

# ─── Firebase client SDK (public) ──────────────────────────────────────────
# Values from Firebase Console → Project Settings → Your Apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin SDK (server) ───────────────────────────────────────────
# From Firebase Console → Project Settings → Service Accounts → Generate key.
#
# Option A — pasted PEM fields:
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Option B — one-line JSON:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}
#
# Option C — local dev convenience:
# Drop the service-account JSON at `.firebase-admin-key.json` in the repo root
# (it is gitignored). admin.ts picks it up when no env vars are set.

# ─── Tenant / branding ─────────────────────────────────────────────────────
# Named preset used before Firestore `settings/app` is populated.
#   base    — neutral "My Store" defaults (recommended for a fresh clone)
#   mishkat — legacy preset preserved for the original deployment
NEXT_PUBLIC_TENANT_PRESET=base

# Logical identifier used to route print jobs when running multiple stores
# through a single print agent. Defaults to "store".
PRINT_STORE_ID=store

# ─── Public site & domains ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional multi-host routing (storefront / portal / read-only menu):
# NEXT_PUBLIC_PUBLIC_HOST=example.com
# NEXT_PUBLIC_PORTAL_HOST=portal.example.com
# NEXT_PUBLIC_MENU_HOST=menu.example.com
# NEXT_PUBLIC_PORTAL_URL=https://portal.example.com
# NEXT_PUBLIC_MENU_URL=https://menu.example.com

# ─── Admin QR cards (optional overrides) ───────────────────────────────────
# NEXT_PUBLIC_QR_LINK_1=https://menu.example.com
# NEXT_PUBLIC_QR_LINK_2=https://example.com

# ─── Local thermal printer (LAN only — never reachable from the cloud) ─────
PRINTER_IP=
PRINTER_PORT=9100
PRINTER_TIMEOUT_MS=8000
PRINTER_DISPLAY_NAME=Kitchen Printer
# Optional Epson ESC t index for Hebrew CP862 (model-dependent)
# PRINTER_HEBREW_CODEPAGE_INDEX=36
# Optional Arabic text-mode (prefer raster if glyphs fail)
# PRINTER_ARABIC_CODEPAGE_INDEX=37
# PRINTER_ARABIC_ENCODING=cp864
# Required in production to expose /api/printer/* LAN test routes
ENABLE_LOCAL_PRINTER_TEST=false

# ─── Kitchen print jobs (cloud) + local print agent ────────────────────────
# Keep auto-print OFF until a physical test receipt is confirmed.
PRINT_AUTO_NEW_ORDERS=false
PRINT_AGENT_TOKEN=
PRINT_AGENT_ENABLED=false
PRINTER_AUTO_CUT=true
PRINTER_BEEP_ON_NEW_ORDER=true

# ─── Auto-bootstrap first admin user ───────────────────────────────────────
# Runs once on first API call if the users collection has no Admin yet.
# CHANGE the default password after first login.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe2026!
ADMIN_BOOTSTRAP_NAME=Store Admin

# ─── Email notifications (Brevo) ───────────────────────────────────────────
# Server-side only; NEVER use NEXT_PUBLIC_ prefix for the API key.
MAIL_PROVIDER=NONE
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_API_KEY=
# Must match a sender you have already verified in your Brevo account.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_REPLY_TO=

# Where new/updated/cancelled order emails are delivered.
STORE_NOTIFICATION_EMAIL=
STORE_ADMIN_EMAIL=
